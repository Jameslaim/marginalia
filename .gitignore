# Library data — NEVER in git.
# The library is transcripts and a ledger; it lives outside this repo, but these
# patterns exist so an accidental copy inside the tree can never be committed.
marginalia-library/
**/marginalia-library/
library/
videos/
ledger.db
*.db
*.db-wal
*.db-shm
**/transcript.txt
**/meta.json
