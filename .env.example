# Example environment variables for marginalia.
#
# marginalia reads these from your shell/process environment (it does not
# automatically parse a .env file). Export them in your shell, load them with
# your preferred env runner, or configure the corresponding keys in config.toml.
# Never commit real credentials or a populated .env file.

# Required unless llm.api_key is set in config.toml.
# API key for your configured OpenAI-compatible LLM endpoint.
MARGINALIA_LLM_API_KEY=your-llm-api-key-here

# Optional. YouTube Data API v3 key for official search.
# If unset (and providers.youtube_api_key is unset in config.toml),
# marginalia falls back to yt-dlp search automatically.
YOUTUBE_API_KEY=

# Optional. Override config file resolution order
# (default order: MARGINALIA_CONFIG -> ./config.toml -> ~/.marginalia/config.toml).
MARGINALIA_CONFIG=

# Optional. Explicit Python 3.11+ interpreter path used by bin/marg and bin/marg.cmd.
MARGINALIA_PYTHON=
